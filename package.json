{
  "name": "sintgpt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "vue-tsc --noEmit",
    "build:cloudflare": "NITRO_PRESET=cloudflare_module nuxt build && tsx scripts/strip-comments.ts .output",
    "build:og": "tsx scripts/build-og-image.ts",
    "build:pdf-designs": "tsx scripts/build-pdf-designs.ts",
    "build:pdf-previews": "tsx scripts/build-pdf-previews.ts",
    "build:pdf-paper": "tsx scripts/build-pdf-paper.ts",
    "deploy": "npm run build:cloudflare && wrangler --cwd .output deploy",
    "analytics": "tsx scripts/analytics-dashboard.ts"
  },
  "dependencies": {
    "@nuxt/image": "^2.2.1",
    "@nuxt/ui": "^4.12.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@resvg/resvg-wasm": "2.6.2",
    "@vueuse/nuxt": "^15.0.0",
    "ai": "^7.0.165",
    "dodopayments": "^2.61.1",
    "dodopayments-checkout": "^2.1.0",
    "mime": "^4.1.2",
    "nuxt": "^4.6.4",
    "pdf-lib": "^1.17.1",
    "standardwebhooks": "^1.1.1",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/devtools": "^4.1.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/color-mode": "^4.1.0",
    "@types/node": "^26.6.6",
    "@types/uuid": "^11.0.0",
    "@types/validator": "^13.15.10",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "playwright-core": "^1.65.0",
    "puppeteer": "^25.16.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.158.0"
  }
}
