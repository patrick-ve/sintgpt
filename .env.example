# Copy to .env for local development. On Cloudflare, set these as Worker
# secrets: npx wrangler secret put <NAME> --name sintgpt

# Vercel AI Gateway (required for poem generation)
NUXT_AI_GATEWAY_API_KEY=
# Optional model override (default: google/gemini-3.7-flash)
# NUXT_AI_GATEWAY_MODEL=openai/gpt-6.1-terra

# Dodo Payments
NUXT_DODO_PAYMENTS_API_KEY=
# Products for the tiers in utils/pricingTiers.ts. NUXT_DODO_PRODUCT_ID is Gezin
# (€6.99); a tier without a product is not offered.
NUXT_DODO_PRODUCT_ID=
NUXT_DODO_PRODUCT_ID_DRIE=
NUXT_DODO_PRODUCT_ID_FAMILIE=
NUXT_DODO_PAYMENTS_WEBHOOK_SECRET=
# Signs the unlimited-access cookie. Generate with: openssl rand -hex 32
# Changing it logs out all paying customers.
NUXT_ACCESS_COOKIE_SECRET=
# Gift links https://sintgpt.com/?cadeau=<code>: Hele familie without paying.
# Comma-separated, each at least 16 characters (openssl rand -hex 16).
# Remove a code to end its access.
NUXT_GIFT_CODES=
