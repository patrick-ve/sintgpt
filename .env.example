# Copy to .env for local development. On Cloudflare, set these as Worker
# secrets: npx wrangler secret put <NAME> --name sintgpt

# Vercel AI Gateway (required for poem generation)
NUXT_AI_GATEWAY_API_KEY=
# Optional model override (default: google/gemini-3.7-flash)
# NUXT_AI_GATEWAY_MODEL=openai/gpt-6.1-terra

# Dodo Payments
NUXT_DODO_PAYMENTS_API_KEY=
# Products for the tiers in utils/pricingTiers.ts. NUXT_DODO_PRODUCT_ID is Gezin
# (€6.99); a tier without a product is not offered.
NUXT_DODO_PRODUCT_ID=
NUXT_DODO_PRODUCT_ID_DRIE=
NUXT_DODO_PRODUCT_ID_FAMILIE=
NUXT_DODO_PAYMENTS_WEBHOOK_SECRET=
# Signs the unlimited-access cookie. Generate with: openssl rand -hex 32
# Changing it logs out all paying customers.
NUXT_ACCESS_COOKIE_SECRET=
# Gift links https://sintgpt.com/?cadeau=<code>: Hele familie without paying.
# Comma-separated, each at least 16 characters (openssl rand -hex 16).
# Remove a code to end its access.
NUXT_GIFT_CODES=
NUXT_GIFT_CODES_SEASON=
# Kill switches, both on when empty: "off" stops the free rewrite of a free
# poem, or writing a poem before payment (the page then shows the payment window).
NUXT_FREE_REWRITE=
NUXT_POEM_PREVIEW=
# Alerts to Telegram (server/plugins/alerts.ts), checked every 10 minutes by a
# Cron Trigger. All three are needed; without them there are no alerts.
# A Cloudflare API token with only "Account Analytics Read".
NUXT_CLOUDFLARE_ANALYTICS_TOKEN=
# From @BotFather, and the chat that gets the messages. The contact form
# (/contact) sends its messages to the same chat.
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=
# Cloudflare Turnstile for the contact form (dashboard: Turnstile, add widget
# for sintgpt.com). Without both, the form answers 503 and the page shows the
# e-mail address. Cloudflare's test pair always passes:
# 1x00000000000000000000AA / 1x0000000000000000000000000000000AA (npm run dev
# uses that site key by itself).
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
