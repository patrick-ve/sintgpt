# Copy to .env for local development. On Cloudflare, set these as Worker
# secrets: npx wrangler secret put <NAME> --name sintgpt

# Vercel AI Gateway (required for poem generation)
NUXT_AI_GATEWAY_API_KEY=
# Optional model override (default: google/gemini-3.1-pro-preview)
# NUXT_AI_GATEWAY_MODEL=google/gemini-3.7-flash

# Dodo Payments
NUXT_DODO_PAYMENTS_API_KEY=
NUXT_DODO_PRODUCT_ID=
NUXT_DODO_PAYMENTS_WEBHOOK_SECRET=
